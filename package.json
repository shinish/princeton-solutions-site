{
  "name": "princeton",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "validate": "next build && node scripts/validate.mjs",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "serve": "serve out -l 3300",
    "shots": "node scripts/shots.mjs",
    "check": "next build && node scripts/validate.mjs && playwright test",
    "seo": "node scripts/seo-audit.mjs",
    "test:live": "BASE_URL=https://shinish.github.io ROUTE_PREFIX=/princeton-solutions-site TRAILING_SLASH=true playwright test",
    "build:pages": "PAGES_BASE_PATH=/princeton-solutions-site NEXT_PUBLIC_SITE_ORIGIN=https://shinish.github.io/princeton-solutions-site NEXT_PUBLIC_ALLOW_INDEXING=true next build"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.13.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
